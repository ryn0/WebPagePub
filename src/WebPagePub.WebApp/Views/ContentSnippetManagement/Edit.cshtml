@model WebPagePub.WebApp.Models.ContentSnippet.ContentSnippetEditModel
@{
    ViewData["Title"] = "Edit Snippet";
}

<h2>@ViewData["Title"]</h2>

<a href="~/sitepages">&lt; back</a>

<form asp-controller="ContentSnippetManagement" asp-action="Edit" method="post" class="form-horizontal">

    @Html.HiddenFor(x => x.ContentSnippetId)
    <div class="form-group">
        <label asp-for="SnippetType" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <select  asp-for="SnippetType" asp-items="Html.GetEnumSelectList<WebPagePub.Data.Enums.SiteConfigSetting>()"></select>
        </div>
    </div>



    <div class="form-group">
        <label asp-for="Content" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            @if (ViewBag.IsSecret == true)
            {
                <p><b>This is a secret.</b> The stored value is not shown. Type a new value to replace it, or leave the box empty to keep the current one.</p>
            }
            <textarea asp-for="Content" class="form-control" rows="10"></textarea>
        </div>
    </div>


    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-success">Update</button>
        </div>
    </div>

</form>

 



