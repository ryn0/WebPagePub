@model WebPagePub.Web.Models.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

 <h2>@ViewData["Title"]</h2>
  @if ((TempData["PasswordChanged"] as string) == "yes")
  {
      <div role="status" style="margin:16px 0;padding:16px 20px;border:2px solid #1e8e3e;background:#e6f4ea;color:#0d5323;border-radius:6px;font-size:1.15em;">
          <strong>&#10003; Your password has been changed.</strong><br />
          Use the new password the next time you sign in. You are still signed in on this device.
          <div style="margin-top:10px;"><a href="~/admin/index">Back to Admin</a></div>
      </div>
  }
  <form asp-controller="Account" asp-action="ChangePassword" 
    method="post" class="form-horizontal">
   
    <hr />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="CurrentPassword" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="CurrentPassword" class="form-control" />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="NewPassword" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="NewPassword" class="form-control" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmNewPassword" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="ConfirmNewPassword" class="form-control" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-default">Change Password</button>
        </div>
    </div>
    
</form>