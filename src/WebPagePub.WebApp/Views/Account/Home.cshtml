@{
    ViewData["Title"] = "Your account";
    var signedInAs = User?.Identity?.IsAuthenticated == true ? User.Identity!.Name : null;
}
<h2>Your account</h2>
<hr />
@if (signedInAs != null)
{
    <div role="status" style="margin:16px 0;padding:16px 20px;border:2px solid #1e8e3e;background:#e6f4ea;color:#0d5323;border-radius:6px;font-size:1.15em;">
        <strong>&#10003; You are signed in.</strong><br />
        Account: <strong>@signedInAs</strong>
    </div>
    <ul>
        <li><a href="~/admin/index">Go to Admin</a></li>
        <li><a href="~/account/changepassword">Change password</a></li>
        <li><a href="~/usermanagement">Users (accounts that can sign in)</a></li>
    </ul>
    <form asp-controller="Account" asp-action="LogOff" method="post">
        <button type="submit" class="btn btn-default">Sign out</button>
    </form>
}
else
{
    <div role="status" style="margin:16px 0;padding:16px 20px;border:2px solid #b3261e;background:#fce8e6;color:#7a1410;border-radius:6px;font-size:1.15em;">
        <strong>You are not signed in.</strong>
    </div>
    <p><a href="~/account/login">Sign in</a></p>
}
