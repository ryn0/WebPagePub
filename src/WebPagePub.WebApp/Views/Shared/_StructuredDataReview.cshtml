@model StructureDataReviewModel
@using Newtonsoft.Json;
@using WebPagePub.WebApp.Models.StructuredData;

@if (Model != null)
{
    <script type="application/ld+json">
        @Html.Raw(WebPagePub.WebApp.Helpers.JsonLd.Serialize(Model)) @* escaped so page text cannot close the script tag *@
    </script>

    <br />

    <div property="reviewRating" typeof="http://schema.org/Rating">
        <meta property="bestRating" content="@(Model?.Review?.ReviewRating?.BestRating ?? "5")">
        <meta property="worstRating" content="@(Model?.Review?.ReviewRating?.WorstRating ?? "1")">
        <b>Overall Rating:</b>
        <span property="ratingValue">@(Model?.Review?.ReviewRating?.RatingValue ?? "3") / 5</span>

        @*<div class="star-ratings-css">
            <div class="star-ratings-css-top" style="width:@Model.Review.RatingPercentage%"><span>★</span><span>★</span><span>★</span><span>★</span><span>★</span></div>
            <div class="star-ratings-css-bottom"><span>★</span><span>★</span><span>★</span><span>★</span><span>★</span></div>
        </div>*@

    </div>

    <br />
}