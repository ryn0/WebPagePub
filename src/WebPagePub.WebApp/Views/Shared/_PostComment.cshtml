@model WebPagePub.WebApp.Models.SitePage.SitePageCommentModel

<form asp-action="Comment" method="post">
    @* The form tag helper already adds the anti-forgery token; a second copy would break the check. *@

    @* your existing fields *@
    <input type="hidden" asp-for="SitePageId" />
    @* A fresh id on every page view. The model is cached and shared by all visitors, so its own
       id was the same for everyone: after one comment, every later comment on the page was
       taken for a repeat and silently dropped. *@
    <input type="hidden" name="RequestId" value="@Guid.NewGuid()" />
    @* Trap for spam scripts: people never see or fill this box. *@
    <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
        <label>Leave this empty <input type="text" name="contact_me_by_fax" tabindex="-1" autocomplete="off" value="" /></label>
    </div>

    <div class="form-group">
        <label asp-for="Name"></label>
        <input class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input class="form-control" asp-for="Email" />
        <span class="text-danger" asp-validation-for="Email"></span>
    </div>

    <div class="form-group">
        <label asp-for="Website"></label>
        <input class="form-control" asp-for="Website" />
        <span class="text-danger" asp-validation-for="Website"></span>
    </div>

    <div class="form-group">
        <label asp-for="Comment"></label>
        <textarea class="form-control" asp-for="Comment" rows="6"></textarea>
        <span class="text-danger" asp-validation-for="Comment"></span>
    </div>

    @{
        var captchaCtx = $"comment:{Model?.SitePageId ?? 0}";
    }
    @await Html.PartialAsync("_CaptchaBlock", captchaCtx)

    <button type="submit" class="btn btn-primary">Post Comment</button>
</form>
